# Environment variables example for Vercel / Production
# (Optional) Resend API Key to receive contact form emails directly
RESEND_API_KEY=re_your_api_key_here

# (Optional) Destination email to receive inquiries (defaults to hkanjer@gmail.com)
CONTACT_NOTIFICATION_EMAIL=hkanjer@gmail.com

# (Optional) Verified sender email configured in Resend (defaults to onboarding@resend.dev during testing)
CONTACT_FROM_EMAIL="Dr. Hanif Kanjer Contact <onboarding@resend.dev>"

